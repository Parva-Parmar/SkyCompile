# SkyCompile Project .gitignore

# =============================================================================
# FRONTEND (React/Vite)
# =============================================================================
# Client-side dependencies
client/node_modules/
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/pnpm-debug.log*
client/lerna-debug.log*

# Runtime data
client/pids
client/*.pid
client/*.seed
client/*.pid.lock

# Coverage directory used by tools like istanbul
client/coverage/
client/*.lcov

# nyc test coverage
client/.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
client/.grunt

# Bower dependency directory (https://bower.io/)
client/bower_components

# node-waf configuration
client/.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
client/build/Release

# Dependency directories
client/jspm_packages/

# TypeScript cache
client/*.tsbuildinfo

# Optional npm cache directory
client/.npm

# Optional eslint cache
client/.eslintcache

# Optional stylelint cache
client/.stylelintcache

# Microbundle cache
client/.rpt2_cache/
client/.rts2_cache_cjs/
client/.rts2_cache_es/
client/.rts2_cache_umd/

# Optional REPL history
client/.node_repl_history

# Output of 'npm pack'
client/*.tgz

# Yarn Integrity file
client/.yarn-integrity

# dotenv environment variable files
client/.env
client/.env.development.local
client/.env.test.local
client/.env.production.local
client/.env.local

# parcel-bundler cache (https://parceljs.org/)
client/.cache
client/.parcel-cache

# Next.js build output
client/.next
client/out

# Nuxt.js build / generate output
client/.nuxt
client/dist

# Gatsby files
client/.cache/
client/public

# Vite build output
client/dist/
client/build/

# Storybook build outputs
client/.out
client/.storybook-out

# Temporary folders
client/tmp/
client/temp/

# =============================================================================
# BACKEND (Spring Boot/Java)
# =============================================================================
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven
backend-spring/target/
backend-spring/.mvn/wrapper/maven-wrapper.properties
backend-spring/.mvn/wrapper/
*.log
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.properties

# Gradle
backend-spring/.gradle
backend-spring/build/
!backend-spring/.gradle/wrapper/gradle-wrapper.jar
backend-spring/!**/src/main/**/build/
backend-spring/!**/src/test/**/build/

# IntelliJ IDEA
backend-spring/.idea/
backend-spring/*.iws
backend-spring/*.iml
backend-spring/*.ipr

# Eclipse
backend-spring/.project
backend-spring/.classpath
backend-spring/.cproject/
backend-spring/.settings/

# NetBeans
backend-spring/nbproject/
backend-spring/nbproject/private/
backend-spring/build/
backend-spring/nbbuild/
backend-spring/dist/
backend-spring/nbdist/
backend-spring/.nb-gradle/

# VS Code
backend-spring/.vscode/

# =============================================================================
# BACKEND (Go)
# =============================================================================
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
backend-go/go.work

# Go build cache
backend-go/cache/

# Go test cache
backend-go/*.test

# Go build output
backend-go/main
backend-go/*.exe

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL data files
*.sql
!database/init.sql
!backend-spring/src/main/resources/schema.sql
*.dump
*.backup
skycompiler_db_data/

# =============================================================================
# COLLABORATION FILES
# =============================================================================
# Yjs snapshots directory
.yjs_snapshots/

# Project files (user content)
skycompiler_projects/
projects/

# =============================================================================
# IDE AND EDITOR FILES
# =============================================================================
# VS Code
.vscode/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# PYTHON ENVIRONMENTS
# =============================================================================
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo

# =============================================================================
# LOGS AND TEMPORARY FILES
# =============================================================================
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
.tmp/
.temp/

# =============================================================================
# CONFIGURATION AND SECRETS
# =============================================================================
# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Configuration files with secrets
config/secrets.js
config/production.js
*.key
*.pem
*.crt
*.p12

# =============================================================================
# TEST AND COVERAGE
# =============================================================================
# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Test results
test-results/
junit.xml

# =============================================================================
# BUILD AND DEPLOYMENT
# =============================================================================
# Build directories
build/
dist/
out/

# Deployment files
deploy/
*.tar.gz
*.zip

# Docker
.dockerignore
docker-compose.override.yml

# =============================================================================
# DOCUMENTATION
# =============================================================================
# Generated documentation
docs/_build/
docs/site/

# =============================================================================
# MISCELLANEOUS
# =============================================================================
# Backup files
*.bak
*.backup
*.old

# Cache directories
.cache/
.parcel-cache/

# Lock files (keep package-lock.json but ignore yarn.lock if using npm)
# package-lock.json
yarn.lock

# Profiler data
*.prof

# Local configuration
config.local.js
settings.local.js

# Debug files
debug.log
debug.txt

# Error logs
error.log
errors.log
